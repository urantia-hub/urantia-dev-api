{
	"name": "urantia-dev-api",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --hot src/index.ts",
		"start": "bun src/index.ts",
		"seed": "bun scripts/seed.ts",
		"seed:entities": "bun scripts/seed-entities.ts",
		"db:generate": "bunx drizzle-kit generate",
		"db:migrate": "bunx drizzle-kit migrate",
		"db:push": "bunx drizzle-kit push",
		"db:studio": "bunx drizzle-kit studio",
		"lint": "bunx biome check src/",
		"format": "bunx biome format --write src/",
		"typecheck": "bunx tsc --noEmit",
		"generate-manifest": "bun scripts/generate-audio-manifest.ts",
		"generate-embeddings": "bun scripts/generate-embeddings.ts",
		"create-hnsw-index": "bun scripts/create-hnsw-index.ts",
		"deploy": "bash scripts/deploy.sh",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@cloudflare/workers-types": "^4.20260702.1",
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.10",
		"wrangler": "4.135.0"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.127.0",
		"@hono/mcp": "^0.3.2",
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.6.3",
		"@logtail/edge": "^0.5.9",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.8",
		"jose": "^6.2.12",
		"music-metadata": "^11.15.0",
		"openai": "^6.49.0",
		"postgres": "^3.4.9",
		"workers-og": "^0.0.27",
		"yaml": "^2.9.1",
		"zod": "^4.6.5"
	},
	"overrides": {
		"yaml": "^2.9.0"
	}
}
